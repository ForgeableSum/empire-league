DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=empire_league
DB_USER=empire_league_app
DB_PASSWORD=replace_me
PUBLIC_MATCHMAKER_URL=http://127.0.0.1:4317
VITE_MATCHMAKER_URL=http://127.0.0.1:4317
MATCHMAKER_HOST=127.0.0.1
# Required to enable the matchmaker-served admin dashboard at /admin.
# Use a long, randomly generated secret and keep it server-side.
MATCHMAKER_ADMIN_TOKEN=
# Weekly FFA games use 8 players by default. Override only for local testing.
# WEEKLY_QUEUE_PLAYERS=2
# Optional: time allowed for a dropped matchmaking socket to reconnect before
# its queue ticket or pending match is cancelled.
TICKET_DISCONNECT_GRACE_MS=20000

# After the first valid replay report, wait this long for an opposing report.
# If none arrives, the first report is trusted and the match is resolved.
MATCH_REPORT_CORROBORATION_TIMEOUT_MS=3600000
# Optional: preferred for Steam persona names. Public profile XML is used as a fallback.
STEAM_WEB_API_KEY=
# Optional: enables a live AoE2 short-video search. Curated shorts are used without it.
VITE_YOUTUBE_API_KEY=
# Optional: shows the top three live Age of Empires II Twitch streams in the sidebar.
# Keep both values server-side; never expose the secret through a VITE_ variable.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
