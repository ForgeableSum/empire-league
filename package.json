{
  "name": "empire-league",
  "version": "0.1.54",
  "description": "AoE2 DE Community Client & Matchmaker",
  "author": "Empire League Prototype",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs",
    "dev:independent-minimize": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs --independent-minimize",
    "dev:opacity": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs --opacity",
    "dev:independent-minimize:opacity": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs --independent-minimize --opacity",
    "dev:permanent-loading-screen": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs --permanent-loading-screen",
    "dev:client": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs --client-only",
    "matchmaker": "node --env-file-if-exists=.env src/matchmaker.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "build": "tsc -p tsconfig.json && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:landing-preview": "vite build --config vite.preview.config.ts && node scripts/inline-landing-preview.mjs",
    "release:windows": "npm run build && electron-builder --win nsis --publish never",
    "package": "npm run build && electron-builder --dir",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:maps": "node --test src/map-catalog.test.mjs",
    "test:civilizations": "node --test src/civilization-roll.test.mjs",
    "test:replays": "node --test src/replay-rules.test.mjs",
    "test:replay-results": "node --test src/replay-result.test.mjs",
    "test:ratings": "node --test src/rating-pool.test.mjs",
    "test:weekly": "node --test src/weekly-rotation.test.mjs",
    "test:tournaments": "node --test src/tournament-bracket.test.mjs src/tournament-chat.test.mjs src/tournament-map.test.mjs src/tournament-password.test.mjs src/tournament-spectator.test.mjs",
    "test:translations": "node scripts/extract-ui-strings.mjs --check && node scripts/audit-ui-translations.mjs"
  },
  "dependencies": {
    "aoe2rec-js": "^0.1.22",
    "electron-updater": "^6.6.2",
    "flag-icons": "^7.5.0",
    "koffi": "^3.1.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "build": {
    "appId": "community.empireleague.aoe2",
    "productName": "Empire League",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "src/renderer/assets/el_icon_no_plume.png",
    "extraResources": [
      {
        "from": "src/renderer/assets/el_icon_no_plume.png",
        "to": "icon.png"
      },
      {
        "from": "assets/aoe2-maps",
        "to": "aoe2-maps"
      }
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://empireleague.gg/updates/windows"
    }
  }
}
