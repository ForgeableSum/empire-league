{
  "name": "empire-league",
  "version": "0.1.0",
  "description": "Electron prototype for an AoE2 DE community 1v1 matchmaking client.",
  "author": "Empire League Prototype",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && node src/dev.mjs",
    "build": "tsc -p tsconfig.json && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder --dir",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "community.empireleague.aoe2",
    "productName": "Empire League",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games"
    }
  }
}
