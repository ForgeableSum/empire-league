{
  "name": "empire-league",
  "version": "0.1.0",
  "description": "Electron prototype for an AoE2 DE community 1v1 matchmaking client.",
  "author": "Empire League Prototype",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs",
    "dev:client": "tsc -p tsconfig.electron.json && node --env-file-if-exists=.env src/dev.mjs --client-only",
    "matchmaker": "node --env-file-if-exists=.env src/matchmaker.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "build": "tsc -p tsconfig.json && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && electron-builder --dir",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "aoe2rec-js": "^0.1.22",
    "flag-icons": "^7.5.0",
    "koffi": "^3.1.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "build": {
    "appId": "community.empireleague.aoe2",
    "productName": "Empire League",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "src/renderer/assets/el-2.png",
    "extraResources": [
      {
        "from": "src/renderer/assets/el-2.png",
        "to": "icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.games"
    }
  }
}
